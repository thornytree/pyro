HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Required server-only credentials. Never use VITE_ prefixes for secrets.
FIRMS_MAP_KEY=
EARTHDATA_TOKEN=

DEFAULT_FORECAST_HOURS=24
LANDFIRE_VERSION=LF2025
# Explicit historical context, NOT current weather. Change to your desired available dates.
DAYMET_START_DATE=2020-07-01
DAYMET_END_DATE=2020-07-31

# Python model API; leave empty to serve observations only.
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_TIMEOUT_MS=15000

# Statewide heat map. Each state costs up to STATE_GRID_MAX_POINTS Open-Meteo
# locations per refresh (large states are sampled coarser to stay within it;
# never finer than the model's 10 km cells) and is reused for the TTL.
STATE_GRID_MAX_POINTS=300
STATE_CACHE_TTL_MINUTES=180
# Reuse a clicked region's five-provider fetch for repeat requests; 0 disables.
TILE_CACHE_TTL_SECONDS=300
