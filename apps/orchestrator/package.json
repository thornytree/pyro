{
  "name": "@pyro/orchestrator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx tests/integration.live.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "csv-parse": "^7.0.3",
    "express": "^5.0.0",
    "geotiff": "^3.0.5",
    "netcdfjs": "^4.0.0",
    "proj4": "^2.23.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.0.0"
  }
}
