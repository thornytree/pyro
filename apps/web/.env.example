# Base URL of apps/orchestrator.
VITE_ORCHESTRATOR_URL=http://localhost:3001
# MapLibre style JSON for the basemap (any MapLibre-compatible style URL).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# "true" serves generated tiles instead of calling the orchestrator.
# Set true to work offline with generated sample data.
VITE_USE_MOCK=false
# Elevation tiles drawn under the live heat map (hillshade, elevation tint and
# contour lines). Leave VITE_TERRAIN_DEM_URL empty to turn terrain off.
# The example is AWS Terrain Tiles (public, no key); see its attribution terms.
VITE_TERRAIN_DEM_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# "terrarium" or "mapbox" (Terrain-RGB).
VITE_TERRAIN_DEM_ENCODING=terrarium
VITE_TERRAIN_DEM_MAXZOOM=15
VITE_TERRAIN_ATTRIBUTION=Elevation: Mapzen Terrain Tiles (USGS 3DEP, SRTM and others)
